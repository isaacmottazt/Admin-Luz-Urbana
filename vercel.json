{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/js/sw.js",
      "headers": [{ "key": "Service-Worker-Allowed", "value": "/" }]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/html/index" },
    { "source": "/index", "destination": "/html/index" },
    { "source": "/admin-galerias", "destination": "/html/admin-galerias" },
    { "source": "/relatorio", "destination": "/html/relatorio" },
    { "source": "/diagnostico-album", "destination": "/html/diagnostico-album" },
    { "source": "/album", "destination": "/html/album" },
    { "source": "/galeria-privada", "destination": "/html/album" }
  ],
  "crons": [
    {
      "path": "/api/telegram-relatorio",
      "schedule": "0 3 * * 1"
    }
  ]
}
